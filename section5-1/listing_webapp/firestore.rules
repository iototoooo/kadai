rules_version = '2';

// このアプリはFirestoreへブラウザから直接アクセスしない設計(すべてサーバー側のFirebase Admin SDK経由)。
// Admin SDKはこれらのルールを経由しないため、ここでは念のためのフェイルセーフとして
// クライアントSDKからの読み書きを全面的に禁止する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
