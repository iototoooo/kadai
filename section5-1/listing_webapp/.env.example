# ローカル実行時、このファイルを .env.local にコピーして値を設定する。
# Cloud Runへデプロイする場合は、これらをCloud Runのサービス環境変数(またはSecret Manager)として設定する。
# ここに書かれた値はコミットしないこと(.env.local は .gitignore 対象)。

# --- Firebase Admin SDK (サーバー側のみ) ---
# サービスアカウントJSONキーは発行しない。Cloud Run実行サービスアカウントの権限を
# Application Default Credentials(ADC)経由で自動的に使う(コード側で対応済み)。
# このためのシークレット値はここには存在しない。
# ローカルでEmulatorを使わずに動作確認する場合のみ、事前に
# `gcloud auth application-default login` が必要。

# FirestoreプロジェクトID
FIREBASE_PROJECT_ID=

# Cloud Storageのバケット名(商品写真の保存先)
FIREBASE_STORAGE_BUCKET=

# --- Firebase Auth 許可アカウント ---
# ログインを許可する唯一のGoogleアカウントのメールアドレス。
ALLOWED_LOGIN_EMAIL=

# セッションCookieの署名等に使う秘密値(任意の長いランダム文字列)。
SESSION_COOKIE_NAME=listing_webapp_session

# --- Firebase Client SDK (ブラウザに公開される。NEXT_PUBLIC_ プレフィックス必須) ---
# Googleサインインのポップアップに必要な、公開して問題ない設定値のみ。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- 既存の item-register-api (Cloud Run) 呼び出し用(サーバー側のみ) ---
ITEM_REGISTER_API_BASE_URL=https://item-register-api-221708489717.asia-northeast1.run.app
ITEM_REGISTER_API_KEY=

# --- 写真の自動削除設定 ---
# listed_at から何日後にCloud Storage上の写真を削除対象とするか(GCSライフサイクルルール側の設定値と一致させる)。
PHOTO_RETENTION_DAYS=30
