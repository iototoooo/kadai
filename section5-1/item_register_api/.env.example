# ローカル実行時、このファイルを .env にコピーして値を設定する。
# Cloud Runへデプロイする場合は、これらをCloud Runのサービス環境変数(またはSecret Manager)として設定する。

# サービスアカウントJSONファイルへのパス(ローカル実行向け)。
# 未設定時は ../../section4-3/service_account.json を使う。
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=

# サービスアカウントJSONの中身をそのまま文字列で渡す場合(Cloud Run + Secret Manager向け)。
# こちらが設定されていれば GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE より優先される。
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# 対象スプレッドシートID(未設定時はデフォルトのVV新・売上管理を使う)
MERCARI_SHEETS_SPREADSHEET_ID=1xMq7gy4d9nPGRGLCX1bltXWxBKXDT1rr66za7zvpmGQ

# GPT Actionsからのリクエストを認証するAPIキー(X-API-Keyヘッダーで照合)。
# 未設定の場合は認証チェックをスキップする(ローカル検証専用。本番では必ず設定すること)。
ITEM_REGISTER_API_KEY=
