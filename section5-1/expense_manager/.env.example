# ローカル実行時、このファイルを .env にコピーして値を設定する。
# Cloud Runへデプロイする場合は、これらをCloud Runのサービス環境変数(またはSecret Manager)として設定する。

# --- Firebase Authentication ---
FIREBASE_PROJECT_ID=
ALLOWED_LOGIN_EMAIL=
SESSION_COOKIE_NAME=expense_manager_session

# Firebase Web SDK向けの公開設定値(ブラウザに渡って問題ない値)。
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=

# --- Gemini API (Google AI Studio) ---
GEMINI_API_KEY=
# 使用モデル名。無料ティア対象モデルは変更されうるため、デプロイ前に要確認。
GEMINI_MODEL=gemini-2.0-flash

# --- Google Sheets / Drive ---
# サービスアカウントJSONファイルへのパス(ローカル実行向け)。
GOOGLE_SERVICE_ACCOUNT_FILE=
# サービスアカウントJSONの中身をそのまま文字列で渡す場合(Cloud Run + Secret Manager向け)。
GOOGLE_SERVICE_ACCOUNT_JSON=

EXPENSE_SPREADSHEET_ID=
EXPENSE_SHEET_NAME=経費
EXPENSE_SUMMARY_SHEET_NAME=集計

# サービスアカウントに編集者共有済みのGoogle DriveフォルダID(証憑保存先ルート)。
EXPENSE_DRIVE_ROOT_FOLDER_ID=
