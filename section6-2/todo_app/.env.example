# ローカル実行時、このファイルを .env にコピーして値を設定する(.env はGit管理外)。
# Cloud Runでは、これらをサービスの環境変数として設定する。秘密情報は含まない構成。

# --- Firebase Authentication ---
FIREBASE_PROJECT_ID=
ALLOWED_LOGIN_EMAIL=
SESSION_COOKIE_NAME=todo_app_session

# Firebase Web SDK向けの公開設定値(ブラウザに渡って問題ない値)。
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=

# --- Google Sheets ---
# 認証はApplication Default Credentials(Cloud Runでは実行サービスアカウント)。キーファイル不要。
TODO_SPREADSHEET_ID=
TODO_SHEET_NAME=Todo
TODO_SETTINGS_SHEET_NAME=設定

# --- LINE期限通知 ---
# Cloud RunではSecret Manager(todo-app-line)から環境変数として渡す。ローカルの .env には書かないこと。
# 形式: {"channel_access_token": "...", "to": "U..."}
TODO_LINE_CONFIG=
# Cloud Scheduler → /internal/notify の呼び出し元検証(OIDC)。
NOTIFY_AUDIENCE=
NOTIFIER_SERVICE_ACCOUNT=
# 通知メッセージ末尾に載せるアプリのURL(任意)。
APP_BASE_URL=
